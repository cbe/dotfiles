[alias]
  ci = commit
  sw = switch
  st = status
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %C(magenta)(%Creset%Cgreen%cr%Creset, %C(blue)%an%Creset%C(magenta))%Creset' --abbrev-commit --date=relative
  sh = show --ext-diff

[init]
  defaultBranch = main

[core]
  hooksPath = ~/dotfiles/git/hooks

[column]
  ui = auto

[branch]
  sort = -committerdate

[tag]
  sort = version:refname

[diff]
  algorithm = histogram
  colorMoved = true
  # difft
  external = difft
  tool = difft

[pull]
  rebase = false # default pull strategy (merge)

[fetch]
  prune = true
  pruneTags = true

[rebase]
  autoStash = true

[pager]
  difftool = true
